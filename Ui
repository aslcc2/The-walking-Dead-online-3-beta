    -- Config System
    function Library:SaveConfig(name)
        if writefile then
            writefile(name .. ".json", HttpService:JSONEncode(WindowObj.ConfigData))
            Library:Notify({Title = "Config Saved", Content = name .. ".json has been saved.", Duration = 3})
        end
    end

    function Library:LoadConfig(name)
        if readfile and isfile and isfile(name .. ".json") then
            local data = HttpService:JSONDecode(readfile(name .. ".json"))
            WindowObj.ConfigData = data
            Library:Notify({Title = "Config Loaded", Content = name .. ".json applied.", Duration = 3})
        end
    end

    function Library:DeleteConfig(name)
        if delfile and isfile and isfile(name .. ".json") then
            delfile(name .. ".json")
            Library:Notify({Title = "Config Deleted", Content = name .. ".json removed.", Duration = 3})
        end
    end

    return WindowObj
end

return Library
