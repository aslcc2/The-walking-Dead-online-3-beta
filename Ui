            ValLbl.TextSize = 13
            ValLbl.TextColor3 = Library.CurrentTheme.SubText
            ValLbl.Position = UDim2.new(0.5, 0, 0, 6)
            ValLbl.Size = UDim2.new(0.5, -12, 0, 16)
            ValLbl.TextXAlignment = Enum.TextXAlignment.Right
            ValLbl.BackgroundTransparency = 1

            local SliderTrack = Instance.new("Frame", Frame)
            SliderTrack.Size = UDim2.new(1, -24, 0, 6)
            SliderTrack.Position = UDim2.new(0, 12, 0, 32)
            SliderTrack.BackgroundColor3 = Library.CurrentTheme.Sidebar

            Instance.new("UICorner", SliderTrack).CornerRadius = UDim.new(1, 0)

            local SliderFill = Instance.new("Frame", SliderTrack)
            SliderFill.Size = UDim2.fromScale((Default - Min) / (Max - Min), 1)
            SliderFill.BackgroundColor3 = Library.CurrentTheme.Accent

            Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)

            local Dragging = false
            local function UpdateSlider(input)
                local pos = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                local val = math.floor(Min + (Max - Min) * pos)
                SliderFill.Size = UDim2.fromScale(pos, 1)
                ValLbl.Text = tostring(val)
                WindowObj.ConfigData[Title] = val
                pcall(Callback, val)
            end

            SliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)

            WindowObj.ConfigData[Title] = Default
        end

        function TabObj:Dropdown(dpConfig)
            dpConfig = dpConfig or {}
            local Title = dpConfig.Title or "Dropdown"
            local Values = dpConfig.Values or {}
            local Selected = dpConfig.Value or Values[1] or ""
            local Callback = dpConfig.Callback or function() end

            local ContainerFrame = Instance.new("Frame", TabPage)
            ContainerFrame.Size = UDim2.new(0, 400, 0, 42)
            ContainerFrame.BackgroundColor3 = Library.CurrentTheme.Element
            ContainerFrame.ClipsDescendants = true

            Instance.new("UICorner", ContainerFrame).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", ContainerFrame).Color = Library.CurrentTheme.Border

            local DpTitle = Instance.new("TextLabel", ContainerFrame)
            DpTitle.Text = Title .. " (" .. Selected .. ")"
            DpTitle.Font = Enum.Font.Govind
            DpTitle.TextSize = 14
            DpTitle.TextColor3 = Library.CurrentTheme.Text
            DpTitle.Position = UDim2.new(0, 12, 0, 12)
            DpTitle.Size = UDim2.new(1, -24, 0, 18)
            DpTitle.TextXAlignment = Enum.TextXAlignment.Left
            DpTitle.BackgroundTransparency = 1

            local ToggleBtn = Instance.new("TextButton", ContainerFrame)
            ToggleBtn.Size = UDim2.new(1, 0, 0, 42)
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Text = ""

            local ListHolder = Instance.new("Frame", ContainerFrame)
            ListHolder.Size = UDim2.new(1, -24, 0, #Values * 28)
            ListHolder.Position = UDim2.new(0, 12, 0, 42)
            ListHolder.BackgroundTransparency = 1

            local Layout = Instance.new("UIListLayout", ListHolder)
            Layout.Padding = UDim.new(0, 2)

            local Expanded = false
            ToggleBtn.MouseButton1Click:Connect(function()
                Expanded = not Expanded
                Tween(ContainerFrame, {0.2}, {Size = UDim2.new(0, 400, 0, Expanded and (46 + #Values * 28) or 42)})
            end)

            for _, val in ipairs(Values) do
                local Item = Instance.new("TextButton", ListHolder)
                Item.Size = UDim2.new(1, 0, 0, 26)
                Item.BackgroundColor3 = Library.CurrentTheme.Sidebar
                Item.Text = val
                Item.Font = Enum.Font.Govind
                Item.TextColor3 = Library.CurrentTheme.SubText
                Item.TextSize = 13

                Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 4)

                Item.MouseButton1Click:Connect(function()
                    Selected = val
                    DpTitle.Text = Title .. " (" .. Selected .. ")"
                    Expanded = false
                    Tween(ContainerFrame, {0.2}, {Size = UDim2.new(0, 400, 0, 42)})
                    WindowObj.ConfigData[Title] = Selected
                    pcall(Callback, Selected)
                end)
            end

            WindowObj.ConfigData[Title] = Selected
        end

