    DescLbl.Text = Content
    DescLbl.Font = Enum.Font.Govind
    DescLbl.TextSize = 14
    DescLbl.TextColor3 = Library.CurrentTheme.SubText
    DescLbl.TextXAlignment = Enum.TextXAlignment.Left
    DescLbl.TextWrapped = true
    DescLbl.BackgroundTransparency = 1

    local BtnHolder = Instance.new("Frame", DialogBox)
    BtnHolder.Size = UDim2.new(1, -24, 0, 36)
    BtnHolder.Position = UDim2.new(0, 12, 1, -48)
    BtnHolder.BackgroundTransparency = 1

    local Layout = Instance.new("UIListLayout", BtnHolder)
    Layout.FillDirection = Enum.FillDirection.Horizontal
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    Layout.Padding = UDim.new(0, 8)

    local function CloseDialog()
        Tween(Overlay, {0.2}, {BackgroundTransparency = 1})
        local tw = Tween(DialogBox, {0.2}, {Position = UDim2.fromScale(0.5, 0.45)})
        tw.Completed:Connect(function()
            Overlay:Destroy()
        end)
    end

    for _, btnData in ipairs(Buttons) do
        local Btn = Instance.new("TextButton", BtnHolder)
        Btn.Size = UDim2.new(0, 80, 1, 0)
        Btn.BackgroundColor3 = Library.CurrentTheme.Element
        Btn.Text = btnData.Title or "Button"
        Btn.Font = Enum.Font.Govind
        Btn.TextColor3 = Library.CurrentTheme.Text
        Btn.TextSize = 14
        Btn.AutoButtonColor = false

        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

        Btn.MouseButton1Click:Connect(function()
            if btnData.Callback then pcall(btnData.Callback) end
            CloseDialog()
        end)
    end

    Tween(DialogBox, {0.2}, {Position = UDim2.fromScale(0.5, 0.5)})
end

