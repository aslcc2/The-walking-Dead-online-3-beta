    local DescLbl = Instance.new("TextLabel", NotifFrame)
    DescLbl.Text = Content
    DescLbl.Font = Enum.Font.Govind
    DescLbl.TextSize = 13
    DescLbl.TextColor3 = Library.CurrentTheme.SubText
    DescLbl.TextXAlignment = Enum.TextXAlignment.Left
    DescLbl.TextWrapped = true
    DescLbl.Size = UDim2.new(1, 0, 0, 0)
    DescLbl.AutomaticSize = Enum.AutomaticSize.Y
    DescLbl.Position = UDim2.new(0, 0, 0, 20)
    DescLbl.BackgroundTransparency = 1

    local Progress = Instance.new("Frame", NotifFrame)
    Progress.Size = UDim2.new(1, 0, 0, 2)
    Progress.Position = UDim2.new(0, 0, 1, -2)
    Progress.BackgroundColor3 = Library.CurrentTheme.Accent
