-- API: Theme Operations
function Library:AddTheme(data)
    if data and data.Name then
        Library.Themes[data.Name] = data
    end
end

function Library:SetTheme(themeName)
    if Library.Themes[themeName] then
        Library.CurrentTheme = Library.Themes[themeName]
        -- Live Theme Updating Logic can be registered here
    end
end

-- API: Notifications
function Library:Notify(options)
    options = options or {}
    local Title = options.Title or "Notification"
    local Content = options.Content or ""
    local Duration = options.Duration or 4

    local NotifFrame = Instance.new("Frame")
